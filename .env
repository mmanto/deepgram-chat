# Backend de gestion.ar (proxy de voz). URL completa: esquema, host y puerto.
# En el móvil por USB: `adb reverse tcp:8000 tcp:8000`.
BACKEND_URL=https://api.intellify.pro

# Opcional: sobrescribe el puerto de BACKEND_URL sin reescribir la URL.
# BACKEND_PORT=8000

# API key del tenant (`tk_live_…`). Se emite en gestion.ar
# (POST /api/admin/tenants/{id}/api-key) y se muestra una sola vez.
# Si queda vacía, la app la pide en Configuración y la guarda en localStorage.
TENANT_ID_PACHOTEAYUDA=tenant_2fc38a44e696
TENANT_KEY=tk_live_IBr2_UTE5zg8fSXywMiFVvKPzwLfP3OldIibe32r7q0

